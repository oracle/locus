          "id": "locus-agent-runs",
          "displayName": "Agent runs",
          "description": "Agent invocations over time, from the invoke_agent spans.",
          "providerId": "apm",
          "providerName": "Application Performance Monitoring",
          "providerVersion": "3.0.0",
          "compartmentId": "${compartmentId}",
          "isOobSavedSearch": false,
          "metadataVersion": "2.0",
          "type": "WIDGET_DONT_SHOW_IN_DASHBOARD",
          "nls": {},
          "screenImage": "",
          "widgetTemplate": "",
          "widgetVM": "",
          "uiConfig": {
            "visualization": {
              "type": "line",
              "x": "time",
              "y": [
                "Runs",
                "Failed"
              ]
            }
          },
          "dataConfig": [
            {
              "dataSource": "apm-trace-explorer",
              "queryText": "show (spans) count(*) as \"Runs\", sum(ErrorCount) as \"Failed\" where OperationName like 'invoke_agent%' timeseries 5 minutes",
              "timeRange": "${timeRange}",
              "apmDomainId": "${apmDomainId}"
            }
          ],
          "drilldownConfig": [],
          "parametersConfig": [],
          "featuresConfig": {},
          "freeformTags": {},
          "definedTags": {}
        },
        {
          "id": "locus-agent-run-latency",
          "displayName": "Run latency by agent",
          "description": "Count, average and p95 duration and failures per agent (gen_ai.agent.name is the span name's suffix).",
          "providerId": "apm",
          "providerName": "Application Performance Monitoring",
          "providerVersion": "3.0.0",
          "compartmentId": "${compartmentId}",
          "isOobSavedSearch": false,
          "metadataVersion": "2.0",
          "type": "WIDGET_DONT_SHOW_IN_DASHBOARD",
          "nls": {},
          "screenImage": "",
          "widgetTemplate": "",
          "widgetVM": "",
          "uiConfig": {
            "visualization": {
              "type": "table"
            }
          },
          "dataConfig": [
            {
              "dataSource": "apm-trace-explorer",
              "queryText": "show (spans) OperationName as \"Agent\", count(*) as \"Runs\", avg(SpanDuration) as \"Avg (ms)\", percentile(SpanDuration, 95) as \"p95 (ms)\", sum(ErrorCount) as \"Failed\" where OperationName like 'invoke_agent%' group by OperationName order by count(*) desc first 20 rows",
              "timeRange": "${timeRange}",
              "apmDomainId": "${apmDomainId}"
            }
          ],
          "drilldownConfig": [],
          "parametersConfig": [],
          "featuresConfig": {},
          "freeformTags": {},
          "definedTags": {}
        },
